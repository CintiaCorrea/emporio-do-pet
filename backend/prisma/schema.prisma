// ===== Protocolos (vacinas, vermifugos, ectoparasitas) =====
model ProtocoloTemplate {
  id             String              @id @default(uuid())
  nome           String // ex: "V10", "Antirrabica"
  tipo           String // VACINA | VERMIFUGO | ECTOPARASITA
  variante       String? // ex: "Anual", "Filhote (3 x 30 dias)"
  doses          Int                 @default(1) // nº de doses da serie inicial
  intervaloDias  Int? // intervalo entre doses da serie
  reforcoMeses   Int? // reforco periodico (ex: 12 = anual)
  indicacaoIdade String? // ex: "A partir de 45 dias"
  idadeMinDias   Int? // p/ sugerir pela idade do pet
  ativo          Boolean             @default(true)
  ordem          Int                 @default(0)
  aplicados      ProtocoloAplicado[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([tipo])
  @@map("protocolo_templates")
}

model ProtocoloAplicado {
  id            String             @id @default(uuid())
  petId         String
  pet           Pet                @relation(fields: [petId], references: [id], onDelete: Cascade)
  tutorId       String?
  tutor         Tutor?             @relation(fields: [tutorId], references: [id], onDelete: SetNull)
