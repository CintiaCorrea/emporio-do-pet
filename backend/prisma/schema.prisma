// ============================================
// AppointmentItem — linhas de cobrança do atendimento
// (de onde sai vendas + comissões + lançamento financeiro)
// ============================================
model AppointmentItem {
  id            String      @id @default(uuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  // Vinculação a catálogo (opcional — pode ser descrição livre)
  servicoId String?
  servico   Servico? @relation(fields: [servicoId], references: [id], onDelete: SetNull)
  productId String? // catálogo unificado (Fase 1 da unificação; dual-write com servicoId)
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  catalogoItemId String? // catálogo NOVO (cat_itens) — liga a linha ao item novo p/ estoque/comissão
  convenioId     String? // convênio pagador (cat_convenios) — item faturado ao convênio, não ao tutor (a-receber mensal)
  descricao String?

  // Executor: profissional interno OU fornecedor externo (lab)
  executorUserId String?
  executorUser   User?       @relation("AppointmentItemExecutor", fields: [executorUserId], references: [id], onDelete: SetNull)
  fornecedorId   String?
  fornecedor     Fornecedor? @relation("AppointmentItemFornecedor", fields: [fornecedorId], references: [id], onDelete: SetNull)

  // Valores
  quantidade    Float @default(1)
  valorUnitario Float @default(0)
  custoUnitario Float @default(0)
  desconto      Float @default(0)
  valorTotal    Float @default(0)

  // Comissão
  comissaoBase      String? // CHEIO | MARGEM | SEM
  comissaoTipo      String? // PERCENTUAL | VALOR_FIXO
  comissaoValor     Float?
  comissaoCalculada Float?
  comissaoExtratoId String? // vincula ao extrato quando fechado

  observacoes String?

  // Origem SimplesVet (importacao de vendas)
  grupo String? // grupo do servico no SimplesVet (Consultas, Cirurgias, Laboratorio...)
  marca String? // marca de negocio derivada do grupo: EMPORIO | MUNDO_A_PARTE | DRA_VIVIAN

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([appointmentId])
  @@index([servicoId])
  @@index([productId])
  @@index([fornecedorId])
  @@index([comissaoExtratoId])
  @@map("appointment_items")
}

