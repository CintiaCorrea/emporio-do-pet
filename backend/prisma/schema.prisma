// ============================================
// Pacotes de fisio: REMOVIDOS na unificação (18/08). A fonte única é a lista
// `petpac_<pet>` (ListaItem) — usada por caixa, financeiro, ficha, inbox, agenda,
// dashboards e portal. As tabelas legadas `pacotes`/`pacote_sessoes` (0 linhas) foram
// dropadas em produção. Ver memória `unificacao-pacote-petpac`.

// ── Internação: Box (baia física) + ocupação ativa ──────────────────
// Box = recurso físico da clínica (CRUD próprio). A internação em si
// continua sendo um Appointment (notes JSON type:HOSPITALIZATION);
// BoxOcupacao liga a baia à internação ativa SEM tocar em Appointment.
model Box {
  id         String        @id @default(uuid())
  codigo     String        @unique
  nome       String?
  tipo       String        @default("CANINO") // CANINO | FELINO | ISOLAMENTO | UTI (editável)
  ativa      Boolean       @default(true)
  ordem      Int           @default(0)
  observacao String?
  ocupacoes  BoxOcupacao[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@map("boxes")
}

model BoxOcupacao {
  id            String    @id @default(uuid())
  boxId         String
  box           Box       @relation(fields: [boxId], references: [id], onDelete: Cascade)
  appointmentId String // referência solta à internação (appointment), SEM FK
  ativa         Boolean   @default(true)
  entradaAt     DateTime  @default(now())
  saidaAt       DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([boxId])
  @@index([appointmentId])
  @@index([ativa])
  @@map("box_ocupacoes")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  userName   String?
  method     String
  module     String
  action     String
  path       String
  entityId   String?
  statusCode Int?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([module])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================
// MODULO FINANCEIRO — Fase 0: dimensoes + plano de contas + lancamento
// Tabelas prefixadas com fin_ para isolar o modulo no schema.
//
// REGRA DE OURO: Unidade, LinhaServico e Marca sao dimensoes INDEPENDENTES
// de cada lancamento. Nunca embutir marca/unidade no nome da categoria
// (licao do sistema antigo: "MO MAP", "CSV - MAP" viravam texto na categoria).
//
// Dinheiro SEMPRE em centavos (Int). Nunca Float.
// ============================================

enum TipoUnidade {
  PROPRIA // receita 100% nossa; taxa de cartao e custo; paga franquia
  PARCERIA // receita entra liquida (split Finpet: 35% parceira / 65% nos)
}

model Unidade {
  id     String      @id @default(uuid())
  nome   String // "Sede", "Unidade Nova"
  tipo   TipoUnidade @default(PROPRIA)
  cidade String?
  ativo  Boolean     @default(true)

  // Quanto fica conosco quando PARCERIA (ex.: 0.6500). Null quando PROPRIA.
  percentualNos Decimal? @db.Decimal(5, 4)

  marcaPadraoId String?
  marcaPadrao   Marca?  @relation(fields: [marcaPadraoId], references: [id])

  lancamentos  Lancamento[]
  contas       ContaFinanceira[]
  faturamentos FaturamentoBruto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tipo])
  @@map("fin_unidades")
}

model Marca {
  id    String  @id @default(uuid())
  nome  String  @unique // "Emporio do Pet", "Mundo a Parte", "Dra. Vivian Correa"
  ativo Boolean @default(true)

  lancamentos Lancamento[]
  unidades    Unidade[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("fin_marcas")
}

// Centro de custo (linha de servico). NAO usar para unidade nem marca.
model LinhaServico {
  id    String  @id @default(uuid())
  nome  String  @unique // "Centro Cirurgico", "Consultorio", "Diagnostico"...
  ordem Int     @default(0)
  ativo Boolean @default(true)

  lancamentos Lancamento[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("fin_linhas_servico")
}

// ---------- Plano de contas ----------

enum TipoCategoria {
  RECEITA
  DESPESA
  TRANSFERENCIA
}

// Natureza: separa o operacional do que NAO entra no EBITDA.
enum NaturezaCategoria {
  OPERACIONAL
  INVESTIMENTO // capex: equipamento, imobilizado, moveis
  FINANCIAMENTO // emprestimos obtidos / pagamento de emprestimo
  NAO_OPERACIONAL
}

enum ComportamentoCusto {
  FIXO
  VARIAVEL
  NAO_APLICAVEL // receitas
}

model GrupoCategoria {
  id    String        @id @default(uuid())
  ordem Int // ordena na DRE (1..n)
  nome  String        @unique // "3. Custos", "8. Investimentos (Capex)"
  tipo  TipoCategoria

  categorias Categoria[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("fin_grupos_categoria")
}

model Categoria {
  id            String             @id @default(uuid())
  nome          String // "Custo do Servico Vendido (CSV)", "Energia Eletrica"
  subgrupo      String? // "Custos Fixos", "Estrutura", "Pessoal"
  tipo          TipoCategoria
  natureza      NaturezaCategoria  @default(OPERACIONAL)
  comportamento ComportamentoCusto @default(NAO_APLICAVEL)
  ordem         Int                @default(0)
  ativo         Boolean            @default(true)

  // Mapeamento opcional para a contabilidade
  codigoContabil String?

  grupoId String
  grupo   GrupoCategoria @relation(fields: [grupoId], references: [id])

  lancamentos Lancamento[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([grupoId, nome])
  @@index([tipo, natureza])
  @@map("fin_categorias")
}

// ---------- Conta (banco/caixa) ----------

// Tipo da conta: define como o saldo entra no DFC e o que NAO afeta o DRE.
// Ideia aproveitada da modelagem do Meu Dinheiro.
enum TipoConta {
  DINHEIRO // caixa em especie
  CONTA_CORRENTE // banco
  CARTAO_CREDITO // fatura a pagar
  CONTAS_A_RECEBER // recebiveis de cartao / maquineta
  APLICACAO_FINANCEIRA // nao afeta DRE, so DFC
  EMPRESTIMO_CONTRATADO // linha propria no DFC (financiamento)
  IMOBILIZADO // capex: equipamentos, obras
  CAPITAL_SOCIAL // aporte de socios
}

model ContaFinanceira {
  id    String    @id @default(uuid())
  nome  String // "Cx Administrativo", "InfinitePay", "Nubank"
  tipo  TipoConta @default(CONTA_CORRENTE)
  ativo Boolean   @default(true)

  // Dados bancários (opcionais) — identificam a conta no banco
  banco       String? // "Nubank", "Itaú"...
  agencia     String?
  numeroConta String? // número + dígito
  titular     String? // nome do titular / razão social
  pixChave    String?

  // Saldo de abertura: ponto de partida do saldo. Pode ser NEGATIVO (conta no vermelho).
  // Fica na conta (não vira lançamento) — não entra na DRE, só semeia o saldo/DFC.
  saldoInicialCentavos Int       @default(0)
  saldoInicialData     DateTime? // data a que esse saldo se refere

  // Conta pode pertencer a uma unidade (usado para inferir a unidade no import)
  unidadeId String?
  unidade   Unidade? @relation(fields: [unidadeId], references: [id])

  lancamentos Lancamento[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("fin_contas")
}

// ---------- Lancamento (o caixa) ----------

enum TipoLancamento {
  RECEITA
  DESPESA
  TRANSFERENCIA // entre contas proprias = neutra, nao entra na DRE
}

enum StatusLancamento {
  PENDENTE
  CONFIRMADO
  CONCILIADO
}

enum OrigemDado {
  MEU_DINHEIRO
  SIMPLESVET
  FINPET
  MANUAL
  CRM // gerado pelo proprio sistema (caixa/comanda)
}

model Lancamento {
  id          String           @id @default(uuid())
  data        DateTime // data de caixa (quando virou dinheiro)
  competencia DateTime // mes de competencia
  // Emissao vem da NF no import (opcional). Vencimento = data-alvo do "a pagar".
  // dataPagamento = caixa efetivo (null enquanto PENDENTE).
  dataEmissao   DateTime?
  vencimento    DateTime?
  dataPagamento DateTime?
  tipo        TipoLancamento
  status      StatusLancamento @default(CONFIRMADO)
  descricao       String?
  // Nº da nota/boleto — SEPARADO da descricao (as regras mexem na descricao, aqui nunca).
  numeroDocumento String?

  // Centavos. Despesa entra negativa. NUNCA Float.
  valorCentavos Int
  // Baixa: principal + juros + multa - desconto = total pago. No DRE, o principal fica na
  // categoria; juros/multa vao p/ Financeiras; desconto p/ "Descontos Financeiros Obtidos".
  jurosCentavos    Int @default(0)
  multaCentavos    Int @default(0)
  descontoCentavos Int @default(0)

  // Rastreabilidade da origem (deduplicacao de import)
  origem     OrigemDado @default(MANUAL)
  externalId String?

  // DIMENSOES — unidade e obrigatoria; as demais sao opcionais
  unidadeId String
  unidade   Unidade @relation(fields: [unidadeId], references: [id])

  categoriaId String?
  categoria   Categoria? @relation(fields: [categoriaId], references: [id])

  linhaServicoId String?
  linhaServico   LinhaServico? @relation(fields: [linhaServicoId], references: [id])

  marcaId String?
  marca   Marca?  @relation(fields: [marcaId], references: [id])

  contaId String
  conta   ContaFinanceira @relation(fields: [contaId], references: [id])

  // Transferencia: conta de destino (referencia solta, sem FK)
  contaDestinoId String?

  // Gerado por uma recorrencia (referencia solta; unique abaixo evita gerar 2x o mesmo mes)
  recorrenciaId String?

  // Apoios (referencias soltas dentro do fin_): fornecedor/cliente e forma de pagamento
  contatoId        String?
  formaPagamentoId String?

  // Ligacoes soltas com o CRM (sem FK, para nao acoplar)
  tutorId       String?
  appointmentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([origem, externalId])
  @@unique([recorrenciaId, vencimento]) // nao gerar 2x a mesma ocorrencia
  @@index([competencia])
  @@index([unidadeId, competencia])
  @@index([categoriaId])
  @@index([status, vencimento]) // filtro "a pagar" / "vencidos"
  @@map("fin_lancamentos")
}

// ---------- Recorrencias: contas que se lancam sozinhas (aluguel, salarios...) ----------

enum FrequenciaRecorrencia {
  MENSAL // dia = dia do mes (1-31; meses curtos usam o ultimo dia)
  SEMANAL // dia = dia da semana (0=domingo .. 6=sabado)
  ANUAL // dia + mesReferencia
}

model Recorrencia {
  id            String                @id @default(uuid())
  descricao     String
  tipo          TipoLancamento // RECEITA ou DESPESA
  // Ultimo valor conhecido. Conta variavel (ex.: energia): gera com este e ajusta na baixa.
  valorCentavos Int

  frequencia    FrequenciaRecorrencia @default(MENSAL)
  dia           Int
  mesReferencia Int? // 1-12, so para ANUAL

  antecedenciaDias Int @default(30) // a conta nasce N dias antes do vencimento

  // Termino opcional: por data ou por quantidade
  terminaEm      DateTime?
  maxOcorrencias Int?

  geradas                Int       @default(0)
  ultimoVencimentoGerado DateTime? // controle da geracao (idempotente)
  ativo                  Boolean   @default(true)

  // Classificacao aplicada aos lancamentos gerados (referencias soltas dentro do fin_)
  categoriaId    String?
  contaId        String
  unidadeId      String
  marcaId        String?
  linhaServicoId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ativo])
  @@map("fin_recorrencias")
}

// ---------- Parceria: bruto + split (o que o caixa nao guarda) ----------

model FaturamentoBruto {
  id          String   @id @default(uuid())
  unidadeId   String
  unidade     Unidade  @relation(fields: [unidadeId], references: [id])
  competencia DateTime
  data        DateTime

  brutoCentavos      Int // faturamento bruto na maquineta
  taxaCartaoCentavos Int @default(0) // taxa descontada pela Finpet
  parceiraCentavos   Int @default(0) // 35% da parceira
  nosCentavos        Int // 65% que vem para nos (= liquido recebido)

  // Vinculo opcional ao lancamento de caixa do liquido
  lancamentoLiquidoId String?

  origem     OrigemDado @default(FINPET)
  externalId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([origem, externalId])
  @@index([unidadeId, competencia])
  @@map("fin_faturamentos_bruto")
}

// ============================================
// MODULO PORTAL DO TUTOR (PTL) — Fatia 1: fundacao do acesso
// Tabelas prefixadas com ptl_ para isolar o modulo no schema.
// Sem FK para o CRM: tutorId e referencia solta (mesmo padrao do fin_/BoxOcupacao).
// SQL cirurgico em prisma/portal/01-fundacao.sql — NAO usar prisma db push.
// ============================================

/// Codigo de acesso (OTP) enviado no WhatsApp. Guarda o HASH, nunca o codigo.
model PortalCodigo {
  id         String    @id @default(uuid())
  telefone   String // normalizado: so digitos, com DDI
  telefone8  String    @map("telefone8") // ultimos 8 digitos — chave de busca
  tipo       String    @default("ACESSO") // ACESSO | DESEMPATE
  codigoHash String    @map("codigo_hash")
  tentativas Int       @default(0)
  expiraEm   DateTime  @map("expira_em")
  usadoEm    DateTime? @map("usado_em")
  ip         String?
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([telefone8])
  @@index([expiraEm])
  @@index([createdAt])
  @@map("ptl_codigos")
}

/// Sessao do tutor no portal (30 dias). Guarda o hash do token.
model PortalSessao {
  id           String    @id @default(uuid())
  tokenHash    String    @unique @map("token_hash")
  tutorId      String    @map("tutor_id") // referencia solta -> tutors.id
  telefone     String
  expiraEm     DateTime  @map("expira_em")
  revogadaEm   DateTime? @map("revogada_em")
  revogadaPor  String?   @map("revogada_por")
  ultimoAcesso DateTime? @map("ultimo_acesso")
  userAgent    String?   @map("user_agent")
  ip           String?
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([tutorId])
  @@index([expiraEm])
  @@map("ptl_sessoes")
}

/// Rastro de acesso ao portal — exigencia de dado de saude (LGPD) e apoio a recepcao.
model PortalAcesso {
  id        String   @id @default(uuid())
  telefone8 String   @map("telefone8")
  evento    String // CODIGO_ENVIADO | CODIGO_ERRADO | ENTROU | SEM_CADASTRO | DESEMPATE | BLOQUEADO | SAIU
  tutorId   String?  @map("tutor_id")
  detalhe   String?
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([telefone8])
  @@index([createdAt])
  @@index([tutorId])
  @@map("ptl_acessos")
}

/// Historico do que o tutor mudou na propria ficha pelo portal — inclusive o que
/// apagou. Uma linha por campo alterado. Nunca e apagada.
model PortalAlteracao {
  id            String   @id @default(uuid())
  tutorId       String   @map("tutor_id")
  entidade      String // TUTOR | PET
  entidadeId    String   @map("entidade_id")
  entidadeNome  String?  @map("entidade_nome")
  campo         String
  valorAnterior String?  @map("valor_anterior")
  valorNovo     String?  @map("valor_novo")
  ip            String?
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([tutorId])
  @@index([entidade, entidadeId])
  @@index([createdAt])
  @@map("ptl_alteracoes")
}

/// Regras gerais do agendamento online (linha unica, id "unico"). Tudo editavel
/// pela equipe em Configuracoes > Agenda > Agendamento online.
model PortalAgendaConfig {
  id                   String   @id
  ativo                Boolean  @default(false)
  antecedenciaMinHoras Int      @default(12) @map("antecedencia_min_horas")
  janelaDias           Int      @default(30) @map("janela_dias")
  prazoCancelarHoras   Int      @default(24) @map("prazo_cancelar_horas")
  maxPorDia            Int      @default(2) @map("max_por_dia")
  desmarcacoesParaTaxa Int      @default(2) @map("desmarcacoes_para_taxa")
  taxaCentavos         Int      @default(0) @map("taxa_centavos")
  mensagemTravado      String?  @map("mensagem_travado")
  atualizadoPor        String?  @map("atualizado_por")
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("ptl_agenda_config")
}

/// Regra de um servico (tipo de atendimento) no agendamento online.
/// Servico novo aparece na tela sozinho e nasce DESLIGADO.
model PortalAgendaServico {
  id         String   @id @default(uuid())
  tipo       String   @unique
  ativo      Boolean  @default(false)
  duracaoMin Int      @default(30) @map("duracao_min")
  agendas    String[] @default([])
  restricao  String   @default("TODOS") // TODOS | JA_CLIENTE | TEM_PACOTE
  ordem      Int      @default(0)
  /// Responsavel quando o servico e marcado numa SALA (o CRM exige um em todo agendamento).
  responsavelUserId String? @map("responsavel_user_id")
  /// Responsavel por dia da semana (sala): { "1": userId, ..., "6": userId } (1=seg..6=sab).
  /// Tem prioridade sobre responsavelUserId. Ex.: fisio nos MAP com Victoria seg-qua / Nayana qui-sab.
  responsavelPorDia Json? @map("responsavel_por_dia")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([ativo])
  @@map("ptl_agenda_servico")
}

/// Rastro dos agendamentos feitos pelo cliente no portal. O agendamento em si e
/// um `Appointment` do CRM; aqui guardamos o que o portal fez, para saber quem
/// desmarcou quantas vezes e para travar dois clientes no mesmo horario
/// (indice unico parcial em agenda_id + inicio quando situacao = MARCADO).
model PortalAgendamento {
  id              String    @id @default(uuid())
  appointmentId   String    @map("appointment_id")
  tutorId         String    @map("tutor_id")
  petId           String    @map("pet_id")
  tipo            String
  agendaId        String    @map("agenda_id")
  inicio          DateTime
  duracaoMin      Int       @map("duracao_min")
  situacao        String    @default("MARCADO") // MARCADO | DESMARCADO | REMARCADO
  desmarcadoEm    DateTime? @map("desmarcado_em")
  remarcadoParaId String?   @map("remarcado_para_id")
  ip              String?
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([tutorId, createdAt])
  @@index([appointmentId])
  @@index([situacao, inicio])
  @@map("ptl_agendamentos")
}

/// Liberacao manual do bloqueio por desmarcacoes (a equipe cobra a taxa e libera).
model PortalLiberacao {
  id          String   @id @default(uuid())
  tutorId     String   @map("tutor_id")
  liberadoPor String?  @map("liberado_por")
  motivo      String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([tutorId, createdAt])
  @@map("ptl_liberacoes")
}

// ============================================
// ALIMENTACAO / DIETA — dado CLINICO (dominio do CRM).
// Quem prescreve e a veterinaria na ficha do pet; o Portal do Tutor apenas LE.
// SQL em prisma/dietas/01-dietas.sql.
// ============================================

/// Dieta prescrita para um pet. Uma ATIVA por pet; as antigas viram historico.
model Dieta {
  id               String   @id @default(uuid())
  petId            String
  pet              Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  tutorId          String?
  /// Snapshot do nome de quem prescreveu (o profissional pode sair da clinica).
  prescritorNome   String?
  prescritorUserId String?
  data             DateTime @default(now())
  ativa            Boolean  @default(true)

  /// [{ nome, detalhe }] — o que o pet come
  itens     Json @default("[]")
  /// ["texto"] — o que o tutor pode variar (verde no portal)
  variacoes Json @default("[]")
  /// ["texto"] — o que evitar (vermelho no portal)
  evitar    Json @default("[]")

  observacao String?
  anexoKey   String?
  anexoNome  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([petId, data])
  @@index([petId, ativa])
  @@map("dietas")
}

/// Aparelho inscrito para receber notificacao do portal (um por celular/tablet).
model PortalPush {
  id          String    @id @default(uuid())
  tutorId     String    @map("tutor_id")
  endpoint    String    @unique
  p256dh      String
  auth        String
  userAgent   String?   @map("user_agent")
  ultimoEnvio DateTime? @map("ultimo_envio")
  falhas      Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([tutorId])
  @@map("ptl_push")
}

/// Rastro do que ja foi avisado — a chave (tutor + assunto) impede aviso repetido.
model PortalPushEnviado {
  id        String   @id @default(uuid())
  tutorId   String   @map("tutor_id")
  assunto   String
  titulo    String?
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([tutorId, assunto])
  @@map("ptl_push_enviados")
}
// ---------- Emprestimo interno: sede -> unidade (capex inicial) ----------
// Fora do resultado operacional. Devolucao de parcela gera transferencia NEUTRA.

model EmprestimoInterno {
  id                String   @id @default(uuid())
  descricao         String
  unidadeTomadoraId String // referencia solta p/ fin_unidades
  valorCentavos     Int
  data              DateTime
  // contas envolvidas (soltas): de onde saiu (sede) e onde entrou (unidade)
  contaOrigemId  String?
  contaDestinoId String?

  parcelas ParcelaEmprestimo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([unidadeTomadoraId])
  @@map("fin_emprestimos_internos")
}

model ParcelaEmprestimo {
  id            String            @id @default(uuid())
  emprestimoId  String
  emprestimo    EmprestimoInterno @relation(fields: [emprestimoId], references: [id], onDelete: Cascade)
  numero        Int // 1..N
  vencimento    DateTime
  valorCentavos Int
  pago          Boolean           @default(false)
  dataPagamento DateTime?
  // transferencia neutra gerada na devolucao (referencia solta)
  lancamentoId  String?

  @@unique([emprestimoId, numero])
  @@index([pago, vencimento])
  @@map("fin_parcelas_emprestimo")
}

// ---------- Contatos e formas de pagamento (apoios) ----------

model Contato {
  id        String   @id @default(uuid())
  nome      String
  documento String? // CNPJ/CPF (dado sensivel)
  tipo      String? // "Fornecedor" | "Cliente" | "Ambos" | "Veterinario parceiro"
  crmv      String? // p/ veterinarios parceiros
  telefone  String?
  email     String?
  pixChave  String? // p/ pagamento (parceiros/fornecedores)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("fin_contatos")
}

model FormaPagamento {
  id        String   @id @default(uuid())
  nome      String
  ordem     Int      @default(0)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("fin_formas_pagamento")
}

// ---------- Auditoria de taxas de cartao ----------
// aliquota/percentual em BASIS POINTS (2.79% = 279 bps) — inteiro, sem float.

model TaxaContratada {
  id             String   @id @default(uuid())
  adquirente     String   @default("InfinityPay") // "InfinityPay", "Nubank"... cada uma tem sua tabela
  bandeira       String // "Visa/Mastercard", "Elo/Amex"
  plano          String // "Padrao", "Nitro"...
  forma          String // "Pix", "Debito", "Credito a vista", "Credito parcelado"
  parcelas       Int // 1 p/ a vista/debito/pix; 2..12 parcelado
  aliquotaBps    Int // 2.79% = 279
  vigenciaInicio DateTime
  observacao     String?
  createdAt      DateTime @default(now())

  @@index([vigenciaInicio])
  @@index([adquirente, vigenciaInicio])
  @@index([bandeira, forma, parcelas])
  @@map("fin_taxas_contratadas")
}

model VendaCartao {
  id              String   @id @default(uuid())
  data            DateTime
  brutoCentavos   Int
  liquidoCentavos Int
  taxaCentavos    Int
  taxaBps         Int // % aplicado no extrato (4.07% = 407)
  planoExtrato    String? // string crua do OFX ("1 Dia Util", "Pix"...)

  // Atribuidos pelo usuario para calcular a esperada
  adquirente String? // "InfinityPay", "Nubank"... de qual maquineta/adquirente veio
  bandeira String?
  forma    String?
  parcelas Int?
  plano    String? // default "Padrao"

  unidadeId  String?
  origem     OrigemDado @default(FINPET)
  externalId String? // FITID do OFX

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([origem, externalId])
  @@index([data])
  @@map("fin_vendas_cartao")
}

// ---------- Regras de classificacao automatica por termo ----------
// "Toda vez que a descricao contiver <termo>, ja classifique assim." Vale receita e despesa.
// Alvos sao referencias soltas (sem FK) dentro do fin_ — a regra so preenche o que estiver setado.

enum EscopoRegra {
  RECEITA
  DESPESA
  AMBOS
}

model Regra {
  id         String      @id @default(uuid())
  termo      String // procurado na descricao (case/acento-insensitive na aplicacao)
  escopo     EscopoRegra @default(AMBOS)
  prioridade Int         @default(0) // desempate quando dois termos casam; menor = ganha
  ativo      Boolean     @default(true)

  // Alvos que a regra preenche (todos opcionais; deixe vazio o que varia caso a caso)
  categoriaId    String?
  unidadeId      String?
  marcaId        String?
  linhaServicoId String?
  contaId        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ativo, prioridade])
  @@map("fin_regras")
}

// ---------- Contas a pagar de fornecedor (geradas do Caixa) ----------
// O FIN LE as vendas do Caixa (appointment_items: fornecedor + custo) e o cadastro de
// Fornecedor (tipo, modeloPagamento, diaFechamentoLote), e ESCREVE so aqui.
// LOTE_MENSAL (laboratorio): acumula numa fatura mensal; ao fechar vira um fin_lancamento.
// Demais (parceiro): cada item vira um a-pagar D+1 direto.
// Refs ao CRM sao soltas (String, sem FK) para nao acoplar.

model FaturaFornecedor {
  id             String    @id @default(uuid())
  fornecedorId   String // ref solta -> fornecedores (CRM)
  fornecedorNome String // snapshot do nome
  competencia    DateTime // 1o dia do mes de referencia
  status         String    @default("ABERTA") // ABERTA | FECHADA
  diaFechamento  Int? // dia do mes (do cadastro do fornecedor)
  vencimento     DateTime?
  totalCentavos  Int       @default(0)
  qtdItens       Int       @default(0)
  unidadeId      String?
  lancamentoId   String? // a-pagar gerado no fechamento (ref solta)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  itens FaturaFornecedorItem[]

  @@unique([fornecedorId, competencia])
  @@index([status])
  @@map("fin_faturas_fornecedor")
}

model FaturaFornecedorItem {
  id                String            @id @default(uuid())
  faturaId          String? // null quando o item vira a-pagar direto (parceiro D+1)
  fatura            FaturaFornecedor? @relation(fields: [faturaId], references: [id], onDelete: SetNull)
  appointmentItemId String            @unique // dedup: cada item do caixa vira conta 1x
  fornecedorId      String
  tipoFornecedor    String // LABORATORIO | PARCEIRO | ...
  descricao         String
  dataServico       DateTime
  custoCentavos     Int
  lancamentoId      String? // parceiro: o a-pagar direto gerado

  createdAt DateTime @default(now())

  @@index([fornecedorId])
  @@index([faturaId])
  @@map("fin_fatura_itens")
}

// ═══════════════════════════════════════════════════════════════════════════
// CATÁLOGO ÚNICO (rebuild do zero — 12/08). Um cadastro só p/ tudo que se vende.
// Produto/Serviço/Exame/Vacina/Pacote/Kit numa entidade, campos condicionais por tipo.
// Tabelas prefixo cat_. NÃO reaproveita Product/Servico/CatalogoExame (arquivados).
// ═══════════════════════════════════════════════════════════════════════════
enum ItemTipo {
  PRODUTO
  SERVICO
  EXAME
  VACINA
  PACOTE
  KIT
}

enum PropositoItem {
  VENDA
  CONSUMO_INTERNO
  AMBOS
}

enum ComissaoTipoItem {
  PERCENTUAL
  VALOR_FIXO
}

enum DescontoModo {
  LIMITE_GERAL
  LIMITE_ITEM
  SEM_DESCONTO
  ATE_100
}

// Grupos em árvore (2 camadas): agrupador (não recebe item, só organiza) + folha.
model CatGrupo {
  id        String     @id @default(cuid())
  nome      String
  paiId     String?
  pai       CatGrupo?  @relation("CatGrupoTree", fields: [paiId], references: [id])
  filhos    CatGrupo[] @relation("CatGrupoTree")
  agrupador Boolean    @default(false) // true = não pode receber item diretamente
  ordem     Int        @default(0)
  ativo     Boolean    @default(true)
  itens     ItemCatalogo[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  @@map("cat_grupos")
}

// Marcas/fabricantes (cadastro à parte).
model CatMarca {
  id    String @id @default(cuid())
  nome  String @unique
  ativo Boolean @default(true)
  itens ItemCatalogo[]
  @@map("cat_marcas")
}

// A ENTIDADE ÚNICA do catálogo.
model ItemCatalogo {
  id                  String    @id @default(cuid())
  codigo              Int?      @unique // sequencial interno visível
  tipo                ItemTipo
  nome                String
  grupoId             String?
  grupo               CatGrupo? @relation(fields: [grupoId], references: [id])
  // preço
  custo               Float?
  fornecedorId        String?   // terceirizado/parceiro (Fornecedor) — ao vender, gera a-pagar D+1 (como o lab do exame). FK string simples.
  markup              Float?    // % desejado
  preco               Float     @default(0)
  exibeListaPreco     Boolean   @default(true)
  permiteAlterarPreco Boolean   @default(true)
  // básico (produto/vacina)
  codigoBarras        String?
  unidadeVenda        String?
  marcaId             String?
  marca               CatMarca? @relation(fields: [marcaId], references: [id])
  proposito           PropositoItem @default(VENDA)
  duracaoMin          Int?      // serviço: duração da sessão
  // estoque (flags + saldo; movimentações vêm na Fatia 4)
  controlaEstoque     Boolean   @default(false)
  estoqueAtual        Float     @default(0)
  estoqueMin          Float?
  estoqueMax          Float?
  controlaValidade    Boolean   @default(false)
  validadeMaisAntiga  DateTime?
  // comissão (camada 1 — padrão do item)
  comissionado        Boolean   @default(false)
  comissaoTipo        ComissaoTipoItem?
  comissaoValor       Float?
  // desconto (cascata: empresa → usuário → item)
  descontoModo        DescontoModo @default(LIMITE_GERAL)
  descontoLimite      Float?
  // vacina: liga ao protocolo clínico (ProtocoloTemplate) — FK string simples
  protocoloTemplateId String?
  // pacote/kit: o que a VENDA cria (a "ponte" com o controle de sessões/doses)
  controlePlano       String? // SESSOES (petpac_) | DOSES (protocolo programado) | null = kit sem controle
  planoUnidades       Int?    // nº de sessões/doses por unidade vendida
  planoIntervaloDias  Int?    // dias entre doses (DOSES)
  // status
  ativo               Boolean   @default(true)
  arquivado           Boolean   @default(false) // soft delete (≠ excluir)
  // relações do catálogo
  exame               ItemExame?
  composicao          ItemComposicao[] @relation("CatComposicaoPai")
  comoInsumo          ItemComposicao[] @relation("CatComposicaoFilho")
  overrides           ItemComissaoOverride[]
  historico           ItemHistorico[]
  movimentos          CatEstoqueMovimento[]
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  @@index([tipo, ativo, arquivado])
  @@index([grupoId])
  @@map("cat_itens")
}

// Extensão 1:1 do EXAME (laboratório + custo do lab).
model ItemExame {
  id                 String  @id @default(cuid())
  itemId             String  @unique
  item               ItemCatalogo @relation(fields: [itemId], references: [id], onDelete: Cascade)
  fornecedorId       String? // laboratório (Fornecedor) — FK string simples
  custoLab           Float?
  prazoResultadoDias Int?
  categoria          String? // categoria de exame (livre)
  externo            Boolean @default(false)
  @@map("cat_item_exame")
}

// Composição de Pacote/Kit (itens que compõem).
model ItemComposicao {
  id         String  @id @default(cuid())
  paiId      String
  pai        ItemCatalogo @relation("CatComposicaoPai", fields: [paiId], references: [id], onDelete: Cascade)
  itemId     String
  item       ItemCatalogo @relation("CatComposicaoFilho", fields: [itemId], references: [id])
  quantidade Float   @default(1)
  @@index([paiId])
  @@map("cat_composicao")
}

// Comissão diferenciada por funcionário (camada 2, sobre a padrão do item).
model ItemComissaoOverride {
  id            String  @id @default(cuid())
  itemId        String
  item          ItemCatalogo @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId        String
  comissaoTipo  ComissaoTipoItem
  comissaoValor Float
  @@unique([itemId, userId])
  @@map("cat_comissao_override")
}

// Auditoria por item (histórico de alterações).
model ItemHistorico {
  id        String   @id @default(cuid())
  itemId    String
  item      ItemCatalogo @relation(fields: [itemId], references: [id], onDelete: Cascade)
  evento    String   // criado | alterado | arquivado | reativado | estoque
  detalhe   String?  // o que mudou
  userId    String?
  userName  String?
  createdAt DateTime @default(now())
  @@index([itemId])
  @@map("cat_historico")
}

// ── ESTOQUE do catálogo novo (Fatia 4): livro-caixa de movimentações + motivos de saída ──
enum MovEstoqueTipo {
  ENTRADA
  SAIDA
  AJUSTE
  INVENTARIO
}

// Motivos de saída configuráveis (avaria, consumo interno, perda de validade, doação…).
model CatMotivoSaida {
  id    String  @id @default(cuid())
  nome  String
  ativo Boolean @default(true)
  @@map("cat_motivos_saida")
}

// Cada entrada/saída/ajuste — com saldo antes/depois (dá o histórico e a média/duração).
model CatEstoqueMovimento {
  id            String         @id @default(cuid())
  itemId        String
  item          ItemCatalogo   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  tipo          MovEstoqueTipo
  quantidade    Float          // ENTRADA/SAIDA = delta; AJUSTE/INVENTARIO = saldo novo absoluto
  saldoAntes    Float
  saldoDepois   Float
  custoUnitario Float?
  motivoId      String?        // p/ SAIDA (CatMotivoSaida)
  motivoNome    String?        // snapshot do motivo
  origem        String         @default("MANUAL") // MANUAL | VENDA | INVENTARIO | COMPRA
  refId         String?        // ex.: id da venda/appointmentItem
  userId        String?
  userName      String?
  obs           String?
  createdAt     DateTime       @default(now())
  @@index([itemId, createdAt])
  @@map("cat_estoque_movimentos")
}

// ── INVENTÁRIO (Fatia 4b): contagem física → gera ajustes de estoque ──
enum InventarioStatus {
  ABERTO
  FECHADO
}

model CatInventario {
  id              String              @id @default(cuid())
  responsavelId   String?
  responsavelNome String?
  status          InventarioStatus    @default(ABERTO)
  totalItens      Int                 @default(0)
  totalCorretos   Int                 @default(0) // contagem bateu com o sistema
  totalCorrigidos Int                 @default(0) // precisou de ajuste
  obs             String?
  itens           CatInventarioItem[]
  createdAt       DateTime            @default(now())
  fechadoAt       DateTime?
  @@map("cat_inventarios")
}

model CatInventarioItem {
  id                String        @id @default(cuid())
  inventarioId      String
  inventario        CatInventario @relation(fields: [inventarioId], references: [id], onDelete: Cascade)
  itemId            String        // FK string simples p/ ItemCatalogo
  itemNome          String        // snapshot
  quantidadeSistema Float         // saldo no momento em que o item entrou na contagem
  quantidadeContada Float
  aplicado          Boolean       @default(false)
  createdAt         DateTime      @default(now())
  @@unique([inventarioId, itemId])
  @@map("cat_inventario_itens")
}

// ── CONVÊNIO (Fatia 7b): pagador MENSAL (a receber) — espelho do laboratório ──
// A clínica atende, marca a venda como "convênio X", fecha o mês e recebe no mês seguinte.
// A tabela "o que o convênio paga" (CatConvenioPreco) traz o valor por procedimento/item.
model CatConvenio {
  id            String             @id @default(cuid())
  nome          String             @unique
  diaFechamento Int?               // dia do mês em que fecha o lote
  contato       String?            // telefone/e-mail do convênio
  ativo         Boolean            @default(true)
  precos        CatConvenioPreco[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  @@map("cat_convenios")
}

// Tabela do convênio: quanto ele paga por procedimento (casado pelo NOME do item; código opcional).
model CatConvenioPreco {
  id             String      @id @default(cuid())
  convenioId     String
  convenio       CatConvenio @relation(fields: [convenioId], references: [id], onDelete: Cascade)
  itemNome       String      // nome do procedimento/exame/serviço na tabela do convênio
  valor          Float       // o que o convênio paga (valor padrão/fallback — 1º porte preenchido)
  precosPorte    String?     // JSON {gato,p,m,g,gg,miniMedio,grande} — preço por porte (null = preço único = valor)
  codigoConvenio String?     // código do procedimento na tabela deles (opcional)
  @@index([convenioId])
  @@map("cat_convenio_precos")
}

// ── FATURA DO CONVÊNIO (a-receber mensal) — espelho de FaturaFornecedor (a-pagar) ──
// A venda marca itens com convenioId; o motor acumula numa fatura mensal por (convenioId, competência).
// Ao FECHAR, a fatura vira UM fin_lancamento RECEITA (a receber), vencimento = dia de fechamento do convênio.
model FaturaConvenio {
  id            String    @id @default(uuid())
  convenioId    String // ref solta -> cat_convenios
  convenioNome  String // snapshot do nome
  competencia   DateTime // 1o dia do mês de referência
  status        String    @default("ABERTA") // ABERTA | FECHADA
  diaFechamento Int? // dia do mês (do cadastro do convênio)
  vencimento    DateTime?
  totalCentavos Int       @default(0)
  qtdItens      Int       @default(0)
  lancamentoId  String? // a-receber gerado no fechamento (ref solta)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  itens FaturaConvenioItem[]

  @@unique([convenioId, competencia])
  @@index([status])
  @@map("fin_faturas_convenio")
}

model FaturaConvenioItem {
  id                String          @id @default(uuid())
  faturaId          String?
  fatura            FaturaConvenio? @relation(fields: [faturaId], references: [id], onDelete: SetNull)
  appointmentItemId String          @unique // dedup: cada item do caixa vira 1 linha da fatura
  convenioId        String
  descricao         String
  dataServico       DateTime
  valorCentavos     Int // o que o convênio paga (tabela do convênio)

  createdAt DateTime @default(now())

  @@index([convenioId])
  @@index([faturaId])
  @@map("fin_fatura_convenio_itens")
}
