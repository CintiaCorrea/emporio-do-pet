  lote          String?
  fabricante    String?
  aplicadaPorId String?
  aplicadaPor   User?             @relation("DoseAplicadaPor", fields: [aplicadaPorId], references: [id], onDelete: SetNull)
  observacao    String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([protocoloId])
  @@index([dataPrevista])
  @@index([status])
  @@map("protocolo_doses")
